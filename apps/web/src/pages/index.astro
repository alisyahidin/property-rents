---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ListingCard from '../components/ListingCard.astro';
import { filterListings, type Listing } from '../lib/filterListings';

const entries = await getCollection('listings');

const listings: Listing[] = entries.map((entry) => ({
	id: entry.id,
	...entry.data,
}));

// Default view: full set, sorted in the shared, consistent order (by Rent
// ascending) — reuses filterListings rather than re-implementing sort logic.
const sortedListings = filterListings(listings, {});

// Full (unfiltered, unsorted-beyond-collection-order) Listing array, embedded
// as JSON for ticket 04's client-side filter island. The island calls
// `filterListings(listings, criteria)` itself, so this payload does not need
// to be pre-sorted or pre-filtered.
const listingsPayload = JSON.stringify(listings).replace(/</g, '\\u003c');
---

<Layout title="Property Rents — Browse Listings">
	<main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
		<header class="mb-6">
			<h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Available Rentals</h1>
			<p class="mt-1 text-sm text-gray-500" id="results-count">
				{sortedListings.length} listing{sortedListings.length === 1 ? '' : 's'}
			</p>
		</header>

		{
			sortedListings.length === 0 ? (
				<p class="text-gray-600">No listings are available right now. Please check back soon.</p>
			) : (
				<>
					<section
						id="listing-filters"
						aria-label="Filter listings"
						class="mb-6 rounded-lg border border-gray-200 bg-white p-4 shadow-sm"
					>
						<div class="mb-3 flex items-center justify-between gap-2">
							<h2 class="text-sm font-semibold text-gray-900">Filter listings</h2>
							<button
								type="button"
								id="clear-filters"
								class="text-sm font-medium text-blue-600 hover:text-blue-800"
							>
								Clear all filters
							</button>
						</div>
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
							<div>
								<label for="filter-property-type" class="block text-xs font-medium text-gray-700">
									Property type
								</label>
								<select
									id="filter-property-type"
									class="mt-1 w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm"
								>
									<option value="">All types</option>
									<option value="apartment">Apartment</option>
									<option value="house">House</option>
									<option value="room">Room</option>
								</select>
							</div>

							<div>
								<label for="filter-city" class="block text-xs font-medium text-gray-700">
									City
								</label>
								<select
									id="filter-city"
									class="mt-1 w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm"
								>
									<option value="">All cities</option>
								</select>
							</div>

							<div>
								<label for="filter-area" class="block text-xs font-medium text-gray-700">
									Area
								</label>
								<select
									id="filter-area"
									class="mt-1 w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm disabled:bg-gray-100 disabled:text-gray-400"
									disabled
								>
									<option value="">Select a city first</option>
								</select>
							</div>

							<div>
								<span class="block text-xs font-medium text-gray-700">Bedrooms</span>
								<div class="mt-1 flex gap-2">
									<input
										type="number"
										id="filter-min-bedrooms"
										min="0"
										inputmode="numeric"
										placeholder="Min"
										aria-label="Minimum bedrooms"
										class="w-1/2 rounded-md border border-gray-300 px-2 py-1.5 text-sm"
									/>
									<input
										type="number"
										id="filter-max-bedrooms"
										min="0"
										inputmode="numeric"
										placeholder="Max"
										aria-label="Maximum bedrooms"
										class="w-1/2 rounded-md border border-gray-300 px-2 py-1.5 text-sm"
									/>
								</div>
							</div>

							<div>
								<span class="block text-xs font-medium text-gray-700">Rent ($/mo)</span>
								<div class="mt-1 flex gap-2">
									<input
										type="number"
										id="filter-min-rent"
										min="0"
										inputmode="numeric"
										placeholder="Min"
										aria-label="Minimum rent"
										class="w-1/2 rounded-md border border-gray-300 px-2 py-1.5 text-sm"
									/>
									<input
										type="number"
										id="filter-max-rent"
										min="0"
										inputmode="numeric"
										placeholder="Max"
										aria-label="Maximum rent"
										class="w-1/2 rounded-md border border-gray-300 px-2 py-1.5 text-sm"
									/>
								</div>
							</div>

							<div class="flex items-end">
								<label class="inline-flex items-center gap-2 text-sm text-gray-700">
									<input
										type="checkbox"
										id="filter-available-only"
										class="h-4 w-4 rounded border-gray-300"
									/>
									Show available only
								</label>
							</div>
						</div>
					</section>

					<p id="no-results-message" class="hidden text-gray-600">
						No listings match your filters. Try broadening your search.
					</p>

					<ul
						id="listings-list"
						class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
					>
						{sortedListings.map((listing) => (
							<ListingCard listing={listing} />
						))}
					</ul>
				</>
			)
		}
	</main>

	<script type="application/json" id="listings-data" set:html={listingsPayload} />

	<script>
		// Ticket 04's client-side filter island: DOM wiring, city→area
		// derivation, criteria reading, and re-rendering all live in
		// listingFilters.ts, kept separate from this page's server-rendering
		// concerns. See src/scripts/listingFilters.ts.
		import { initListingFilters } from '../scripts/listingFilters';

		initListingFilters();
	</script>
</Layout>
