---
// Small shared badge for a Listing's Availability (CONTEXT.md: `available` | `rented`).
// A `rented` Listing stays published (badged, not deleted) rather than disappearing.
interface Props {
	availability: "available" | "rented";
}

const { availability } = Astro.props;
const isAvailable = availability === "available";
---

<span
	class:list={[
		"inline-flex items-center rounded-full px-3 py-1 text-sm font-medium",
		isAvailable ? "bg-green-100 text-green-800" : "bg-gray-200 text-gray-600",
	]}
>
	{isAvailable ? "Available" : "Rented"}
</span>
